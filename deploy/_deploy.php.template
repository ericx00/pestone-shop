<?php

/*
|--------------------------------------------------------------------------
| FTP-only deploy bootstrap
|--------------------------------------------------------------------------
| No terminal/SSH/cPanel-API needed: GitHub Actions FTPs THIS file plus
| app.zip + webroot.zip into public_html, then hits this URL. It extracts
| both archives into place with PHP's ZipArchive (pure local disk I/O — a
| few seconds even for thousands of files, unlike transferring each one
| over FTP) and deletes the zips + itself when done.
|
| Token is baked in at build time from the DEPLOY_TOKEN secret — keep this
| file out of the git repo (it's generated fresh into deploy/_deploy.php by
| the CI workflow, gitignored).
*/

set_time_limit(0);
ini_set('memory_limit', '512M');
header('Content-Type: text/plain');

$token = $_GET['token'] ?? '';
if (! hash_equals('__DEPLOY_TOKEN__', $token)) {
    http_response_code(404);
    exit("Not found\n");
}

$webRoot = __DIR__;                 // .../public_html
$home = dirname($webRoot);          // .../ (account home)
$appDir = $home.'/pestone-shop';

$jobs = [
    ['zip' => $webRoot.'/_deploy_app.zip', 'to' => $appDir],
    ['zip' => $webRoot.'/_deploy_webroot.zip', 'to' => $webRoot],
];

function extract_zip(string $zipPath, string $to): array
{
    if (! is_dir($to) && ! mkdir($to, 0755, true) && ! is_dir($to)) {
        return [false, "could not create {$to}"];
    }

    // Prefer the zip extension when it's available.
    if (class_exists('ZipArchive')) {
        $zip = new ZipArchive;
        if ($zip->open($zipPath) === true) {
            $count = $zip->numFiles;
            $ok = $zip->extractTo($to);
            $zip->close();

            return $ok ? [true, "{$count} files (ZipArchive)"] : [false, 'ZipArchive extractTo failed'];
        }
    }

    // Fall back to the `unzip` binary via exec() — no PHP zip extension needed.
    if (function_exists('exec')) {
        $cmd = 'unzip -o -q '.escapeshellarg($zipPath).' -d '.escapeshellarg($to).' 2>&1';
        exec($cmd, $out, $status);

        return $status === 0
            ? [true, 'via unzip binary']
            : [false, 'unzip exited '.$status.': '.implode(' ', $out)];
    }

    return [false, 'no ZipArchive and no exec() available — ask your host to enable the PHP zip extension'];
}

foreach ($jobs as $job) {
    echo "Extracting {$job['zip']} -> {$job['to']}\n";

    if (! is_file($job['zip'])) {
        echo "  skip (not found)\n";

        continue;
    }

    [$ok, $detail] = extract_zip($job['zip'], $job['to']);
    echo $ok ? "  ok ({$detail})\n" : "  FAILED: {$detail}\n";

    if ($ok) {
        @unlink($job['zip']);
    }
}

echo "Done.\n";

@unlink(__FILE__);
